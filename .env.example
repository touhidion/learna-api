# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=debug               # debug | info | warn | error

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL 16)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=learna
DB_PASSWORD=learna
DB_NAME=learna
DB_SSLMODE=disable            # disable | require | verify-full
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Run pending migrations automatically on boot.
DB_AUTO_MIGRATE=true

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
# CHANGE THIS. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=learna-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h          # 7 days
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# ─────────────────────────────────────────────────────────────
# CORS — comma-separated origins, or * to allow all (dev only)
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Rate limiting (auth endpoints)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=5              # sustained requests per second, per IP
RATE_LIMIT_BURST=10

# ─────────────────────────────────────────────────────────────
# First-run super admin seed (created only if no super_admin exists)
# ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@learna.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# ─────────────────────────────────────────────────────────────
# Cloudinary — https://console.cloudinary.com
# Leave CLOUDINARY_URL empty to disable uploads (endpoints return 503).
# ─────────────────────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_FOLDER=learna
UPLOAD_MAX_FILE_SIZE=26214400 # 25 MB, Cloudinary free-tier limit

# ─────────────────────────────────────────────────────────────
# Certificates
# ─────────────────────────────────────────────────────────────
CERT_NUMBER_PREFIX=LEARNA
CERT_SITE_NAME=Learna
