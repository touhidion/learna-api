# ─────────────────────────────────────────────────────────────
# learna-api — reference configuration.
#
# This file is committed and holds NO real secrets. The values actually
# used are read, highest precedence first, from:
#
#   1. the real process environment
#   2. $ENV_FILE                 — explicit override
#   3. .env.<APP_ENV>.local      — personal, gitignored
#   4. .env.<APP_ENV>            — .env.development / .env.production
#   5. .env                      — shared fallback
#
# A variable already set is never overwritten, so the first file to
# define a key wins. Copy this file to .env.development to get started.
#
#   APP_ENV=development  ->  .env.development  (port 8081)
#   APP_ENV=production   ->  .env.production   (port 8082)
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=debug               # debug | info | warn | error

# Which proxies may set X-Forwarded-For. Behind a platform load balancer this
# MUST include that proxy, or every request reports the balancer's IP and the
# per-IP rate limiter throttles all users as one client.
#   local / direct      -> 127.0.0.1,::1   (default)
#   Render, Fly, etc.   -> *               (edge overwrites the header)
TRUSTED_PROXIES=127.0.0.1,::1

# PORT, when set, overrides SERVER_PORT. Render/Heroku/Cloud Run inject it and
# route to exactly that port, so do not set it yourself on those platforms.

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL 16)
#
# DATABASE_URL, when set, is used verbatim and every DB_HOST/PORT/USER/
# PASSWORD/NAME/SSLMODE value below is ignored. Prefer it for managed
# providers (Neon, Supabase, Railway, Heroku), whose connection strings
# carry options that cannot be rebuilt from discrete parts:
#
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require&channel_binding=require
#
# Both postgres:// and postgresql:// schemes are accepted.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=

# Used only when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_USER=learna
DB_PASSWORD=learna
DB_NAME=learna
DB_SSLMODE=disable            # disable | require | verify-full
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h

# Run pending migrations automatically on boot.
DB_AUTO_MIGRATE=true

# ─────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────
# CHANGE THIS. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=learna-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h          # 7 days
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# ─────────────────────────────────────────────────────────────
# CORS — comma-separated origins, or * to allow all (dev only)
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Rate limiting (auth endpoints)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=5              # sustained requests per second, per IP
RATE_LIMIT_BURST=10

# ─────────────────────────────────────────────────────────────
# First-run super admin seed (created only if no super_admin exists)
# ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@learna.local
SUPER_ADMIN_PASSWORD=ChangeMe123!
SUPER_ADMIN_NAME=Super Admin

# Re-sync the existing super admin's password to SUPER_ADMIN_PASSWORD on the
# next seed. Off by default: on a deploy it would otherwise silently undo a
# password rotated through the API. Set true, sync once, then set back to false.
SUPER_ADMIN_RESET_PASSWORD=false

# ─────────────────────────────────────────────────────────────
# Cloudinary — https://console.cloudinary.com
# Leave CLOUDINARY_URL empty to disable uploads (endpoints return 503).
# ─────────────────────────────────────────────────────────────
CLOUDINARY_URL=
CLOUDINARY_FOLDER=learna
UPLOAD_MAX_FILE_SIZE=26214400 # 25 MB, Cloudinary free-tier limit

# ─────────────────────────────────────────────────────────────
# Certificates
# ─────────────────────────────────────────────────────────────
CERT_NUMBER_PREFIX=LEARNA
CERT_SITE_NAME=Learna
